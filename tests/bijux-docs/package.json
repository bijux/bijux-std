{
  "name": "bijux-std-ui-tests",
  "private": true,
  "version": "0.1.0",
  "description": "UI regression checks for bijux-std shared docs shell",
  "scripts": {
    "test:ui": "playwright test --config playwright.config.js",
    "test:ui:live-navigation": "playwright test --config playwright.live.config.js",
    "test:ui:headed": "playwright test --headed",
    "test:ui:debug": "playwright test --debug",
    "install:browsers": "playwright install chromium firefox webkit"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.58.2",
    "rxjs": "7.8.2"
  }
}
